<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>b1dc1131-52a3-4926-adc5-fc01a7bcfdb2</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- JwtBearer：驗證請求帶來的 token（認證）。 -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Tokens.Jwt：簽發 token 用的 JwtSecurityToken（簽在這包，驗在 JwtBearer 那包）。 -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
  </ItemGroup>

  <!-- ModelFiles 跟著輸出與發佈目錄走：程式用 ContentRootPath 組路徑，
       直接執行 bin 內執行檔或部署後根目錄會變，少了這段 /models/{modelKey} 一律 404。 -->
  <ItemGroup>
    <None Update="ModelFiles\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
</Project>
